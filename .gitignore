# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Node modules
/node_modules
/frontend/node_modules
/backend/node_modules

# Frontend dependencies
/frontend/.pnp
/frontend.pnp.js

# Production (frontend)
/frontend/build

# Production (backend)
/backend/dist

# Misc (global)
/.DS_Store

# Environment files
/.env

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore editor specific files
*.log
.idea/
.vscode/
